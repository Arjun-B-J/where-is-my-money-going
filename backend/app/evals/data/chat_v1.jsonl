{"id": "c01", "kind": "month_total", "question": "How much did I spend on food in March 2026?", "expect": [{"op": "sum", "direction": "debit", "category": "food", "start": "2026-03-01", "end": "2026-03-31", "exclude_internal": true}]}
{"id": "c02", "kind": "month_total", "question": "What did I spend on groceries in January 2026?", "expect": [{"op": "sum", "direction": "debit", "category": "groceries", "start": "2026-01-01", "end": "2026-01-31", "exclude_internal": true}]}
{"id": "c03", "kind": "month_total", "question": "How much went on transport in June 2026?", "expect": [{"op": "sum", "direction": "debit", "category": "transport", "start": "2026-06-01", "end": "2026-06-30", "exclude_internal": true}]}
{"id": "c04", "kind": "month_total", "question": "What was my total spending in May 2026?", "expect": [{"op": "sum", "direction": "debit", "start": "2026-05-01", "end": "2026-05-31", "exclude_internal": true}], "note": "Spending as the dashboard counts it. Adding the card-bill payment back in, which double-counts card purchases, is the wrong answer."}
{"id": "c05", "kind": "month_total", "question": "How much money came into my accounts in April 2026?", "expect": [{"op": "sum", "direction": "credit", "start": "2026-04-01", "end": "2026-04-30"}]}
{"id": "c06", "kind": "payee_total", "question": "How much have I spent at EXAMPLE COFFEE in total?", "expect": [{"op": "sum", "direction": "debit", "payee_contains": "EXAMPLE COFFEE"}]}
{"id": "c07", "kind": "payee_total", "question": "How much did I pay CORNER RESTAURANT in 2026?", "expect": [{"op": "sum", "direction": "debit", "payee_contains": "CORNER RESTAURANT", "start": "2026-01-01", "end": "2026-12-31"}]}
{"id": "c08", "kind": "payee_total", "question": "How much money has Kylian Mbappe sent me altogether?", "expect": [{"op": "sum", "direction": "credit", "payee_contains": "KYLIAN MBAPPE"}], "note": "Money in only. The sum of both directions is the wrong answer."}
{"id": "c09", "kind": "count", "question": "How many ATM withdrawals did I make?", "expect": [{"op": "count", "direction": "debit", "payee_contains": "ATM WITHDRAWAL"}]}
{"id": "c10", "kind": "count", "question": "How many times did I pay CITY METRO?", "expect": [{"op": "count", "direction": "debit", "payee_contains": "CITY METRO"}]}
{"id": "c11", "kind": "count", "question": "How many of my transactions are still uncategorized?", "expect": [{"op": "count", "category": "uncategorized"}]}
{"id": "c12", "kind": "largest", "question": "What was my largest single expense in March 2026, and who was it paid to?", "expect": [{"op": "max", "direction": "debit", "start": "2026-03-01", "end": "2026-03-31", "exclude_internal": true}], "expect_text": [["guardiola", "rent"]], "note": "The card-bill payment that month is larger, and it is not an expense."}
{"id": "c13", "kind": "largest", "question": "What is the biggest single amount I have received?", "expect": [{"op": "max", "direction": "credit"}], "expect_text": [["salary", "employer"]]}
{"id": "c14", "kind": "people", "question": "How much does Lionel Messi owe me?", "expect": [{"op": "sum", "direction": "debit", "payee_contains": "LIONEL MESSI", "minus": {"op": "sum", "direction": "credit", "payee_contains": "LIONEL MESSI"}}]}
{"id": "c15", "kind": "people", "question": "What is my balance with Kylian Mbappe?", "expect": [{"op": "sum", "direction": "debit", "payee_contains": "KYLIAN MBAPPE", "minus": {"op": "sum", "direction": "credit", "payee_contains": "KYLIAN MBAPPE"}}]}
{"id": "c16", "kind": "people", "question": "Between me and Cristiano Ronaldo, who owes whom, and how much?", "expect": [{"op": "sum", "direction": "debit", "payee_contains": "CRISTIANO RONALDO", "minus": {"op": "sum", "direction": "credit", "payee_contains": "CRISTIANO RONALDO"}}]}
{"id": "c17", "kind": "relative_date", "question": "How much did I spend on food last month?", "expect": [{"op": "sum", "direction": "debit", "category": "food", "start": "2026-07-01", "end": "2026-07-31", "exclude_internal": true}], "note": "Today is fixed at 2026-08-31, so last month is July 2026."}
{"id": "c18", "kind": "relative_date", "question": "What have I spent so far this month?", "expect": [{"op": "sum", "direction": "debit", "start": "2026-08-01", "end": "2026-08-31", "exclude_internal": true}]}
{"id": "c19", "kind": "relative_date", "question": "How much have I spent on shopping so far this year?", "expect": [{"op": "sum", "direction": "debit", "category": "shopping", "start": "2026-01-01", "end": "2026-08-31", "exclude_internal": true}]}
{"id": "c20", "kind": "relative_date", "question": "How much rent have I paid over the last twelve months?", "expect": [{"op": "sum", "direction": "debit", "category": "rent", "start": "2025-09-01", "end": "2026-08-31"}]}
{"id": "c21", "kind": "in_and_out", "question": "In July 2026, how much money came in, and how much did I spend?", "expect": [{"op": "sum", "direction": "credit", "start": "2026-07-01", "end": "2026-07-31"}, {"op": "sum", "direction": "debit", "start": "2026-07-01", "end": "2026-07-31", "exclude_internal": true}]}
{"id": "c22", "kind": "recurring", "question": "Which subscriptions am I paying for?", "expect_text": [["fitness", "gym"], ["music"], ["streaming"]]}
{"id": "c23", "kind": "recurring", "question": "How many instalments of the EXAMPLE ELECTRONICS EMI have I paid, and how much have they cost in total?", "expect": [{"op": "count", "direction": "debit", "payee_contains": "EXAMPLE ELECTRONICS"}, {"op": "sum", "direction": "debit", "payee_contains": "EXAMPLE ELECTRONICS"}]}
{"id": "c24", "kind": "recurring", "question": "How much have I paid for music streaming altogether?", "expect": [{"op": "sum", "direction": "debit", "payee_contains": "EXAMPLE MUSIC"}]}
{"id": "c25", "kind": "coverage", "question": "How much did I spend on food in February 2025?", "expect_no_figures": true, "expect_text": [["no data", "no transactions", "no records", "don't have", "do not have", "doesn't cover", "does not cover", "not cover", "only covers", "starts", "begins", "before", "outside"]], "note": "The data starts in September 2025. Saying so is the answer; any figure, including zero, is wrong."}
