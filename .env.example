# Copy to .env and adjust. Every value here has a working default, so an empty
# .env is fine for local use.

# ---- Local model (Ollama) ----
LLM_HOST=http://localhost:11434
LLM_MODEL=gemma4:26b
LLM_VISION_MODEL=gemma4:26b
LLM_TIMEOUT_S=180

# The default model is a reasoning model, and its thinking channel corrupts
# schema-constrained JSON while making prose generation about 100x slower. Leave
# this false unless you swap in a model that needs thinking enabled.
LLM_THINK=false

# Parallel classification calls. 4 keeps one consumer GPU busy without thrashing
# its memory; drop to 1 on a laptop without a discrete GPU.
LLM_CONCURRENCY=4

# ---- Learning from your corrections ----
# Rows you categorise by hand are shown to the classifier as examples when it meets
# the same or a similar payee. The embedding model only ever influences a label.
MEMORY_ENABLED=true
EMBED_MODEL=embeddinggemma
MEMORY_TOP_K=4
MEMORY_MIN_SIMILARITY=0.80
# Similar matches must also share the payee's name. See docs/DECISIONS.md section 19.
MEMORY_NAME_CHECK=true

# ---- Tagging ----
# Below this confidence a transaction goes to the review queue instead of being
# trusted. The model reports 0.3-0.6 for payments to unrecognised individuals,
# which are exactly the rows worth a human glance.
CONFIDENCE_THRESHOLD=0.70

# Send every transaction to the model. Set false to run the regex rule engine
# first instead — much faster, weaker on merchants no rule was written for.
LLM_FIRST=true

# ---- Storage ----
DATABASE_URL=sqlite:///./storage/wimmg.db

# ---- Web ----
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
